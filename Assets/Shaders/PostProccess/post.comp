#version 460
layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout (rgba32f, binding = 7) uniform writeonly image2D gFinal;

layout(binding = 0)uniform sampler2D gLighting; 
layout(binding = 2) uniform sampler2D gEmissive; 
layout(binding = 1) uniform sampler2D gSSR; 
layout(binding = 3 )uniform sampler2D gTransparent; 
layout(binding = 4 )uniform sampler2D gData; 
layout(binding = 5 )uniform sampler2D gTransparentPos; 
layout(binding = 6 )uniform sampler2D gPosition; 
layout(binding = 8 )uniform sampler2D gFur; 

uniform vec2 screen;
uniform vec3 viewPos;

uniform bool isDead;
uniform float isSwimming;


vec4 center;
vec4 boxBlur2D(vec2 texCoords, vec2 offset1, vec2 texOffset, int kernelSize, float type)
{
    vec4 result = vec4(0.0);
    int kernelRadius = kernelSize / 2;
    int sampleCount = kernelSize * kernelSize;

    vec2 screenCenter = vec2(0.5);
    float distFromCenter = length(texCoords - screenCenter);
    float falloff = pow(clamp(1.0 - distFromCenter * 2.5, 0.0, 1.0), 2.0); // smooth radial falloff

    float centerDepth = texture(gData, texCoords).z;

    for (int x = -kernelRadius; x <= kernelRadius; ++x)
    {
        for (int y = -kernelRadius; y <= kernelRadius; ++y)
        {
            // Distorted sample position
            vec2 distortedCoords = texCoords + offset1;
            float distortedDepth = texture(gPosition, clamp(distortedCoords, vec2(0.0), vec2(1.0))).w;

            // Smooth blend between distorted and original texCoords
            float depthDiff = abs(centerDepth - distortedDepth);
            float blendFactor = smoothstep(0.01, 0.1, depthDiff); // smooth blend based on depth diff

            vec2 blendedCoords = mix(texCoords, distortedCoords, blendFactor);
            vec2 finalDistortion = blendedCoords - texCoords;
            vec2 finalCoords = texCoords + finalDistortion * falloff;

            // Offsets for blur kernel (adjusted slightly for emissive layer)
            vec2 lightingOffset = vec2(texOffset.x * x, texOffset.y * y);
            vec2 emissiveOffset = vec2((texOffset.x + 0.005) * x, (texOffset.y + 0.005) * y);

            // Clamp to valid screen space
            vec2 lightingSampleCoords = clamp(finalCoords + lightingOffset, vec2(0.0), vec2(1.0));
            vec2 emissiveSampleCoords = clamp(finalCoords + emissiveOffset, vec2(0.0), vec2(1.0));

            result += texture(gLighting, lightingSampleCoords);
            result += texture(gEmissive, emissiveSampleCoords);
        }
    }

    result /= float(sampleCount);
    return result;
}


void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    vec2 UV = (vec2(gl_GlobalInvocationID.xy) + 0.5) / screen;
    /*
    float threshold = 0.0002; // Distance threshold
    if (length(UV - vec2(0.5, 0.5)) <= threshold) {
        imageStore(gFinal, coords,vec4(1));
        return;
    }
    */

    // Retrieve data from G-buffer
    vec4 transparent = texture(gTransparent, UV).rgba;
    vec4 transparentData = texture(gData, UV).rgba;

    vec4 lighting = texture(gLighting, UV).rgba;
    vec4 ssr = vec4(texture(gSSR, UV).rg,0,0);
    vec2 texSize  = textureSize(gSSR, 0).xy;
    vec4 emissive = vec4(texture(gEmissive, UV).rgb,1); 
    vec4 albedo = lighting + emissive;


    if(transparent.rgb != vec3(0)){
        //vec4 blurredImage = boxBlur2D(UV, vec2(0.0015), 5);
        float gDepth = texture(gPosition,UV).w;
        float gTransDepth = texture(gPosition,UV).w;

        vec2 texSize = textureSize(gLighting,0).xy;
        vec2 backgroundUV = UV * texSize;
        backgroundUV = floor(backgroundUV) + 0.5;
        backgroundUV /= texSize;
        float type = transparentData.w;
        vec4 backgroundSample = boxBlur2D(backgroundUV,transparentData.xy,vec2(0.001),3,type);


        if (gDepth < texture(gData, UV).z)
            backgroundSample = texture(gLighting, clamp(UV, vec2(0), vec2(1))) + texture(gEmissive, UV);
        vec4 blended = backgroundSample + vec4(transparent.rgb,0);

        
        if(isDead)
            blended = blended + vec4(1,-0.2,-0.2,1);
        if(isSwimming > 0)
            blended = blended + vec4(0, 0.161, 0.239,1) * clamp(isSwimming,0.0f,0.25f) * 4;
           
        imageStore(gFinal, coords, blended);
    }else{
        if(isDead)
            albedo = albedo + vec4(1,-0.2,-0.2,1);
        if(isSwimming > 0)
            albedo = albedo + vec4(0, 0.161, 0.239,1) * clamp(isSwimming,0.0f,0.25f) * 4;

        
        imageStore(gFinal, coords,vec4(albedo.xyz,1) + ssr);
    }


}