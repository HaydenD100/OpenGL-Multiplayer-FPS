vec4 sampleCubeArray(vec3 dir, int index) {
    vec3 absDir = abs(dir);
    float maxComp = max(absDir.x, max(absDir.y, absDir.z));
    
    int face;
    vec2 uv;
    
    if(maxComp == absDir.x) {
        bool positive = dir.x > 0;
        face = positive ? 0 : 1;
        uv = vec2(positive ? -dir.z : dir.z, -dir.y) / absDir.x;
    } else if(maxComp == absDir.y) {
        bool positive = dir.y > 0;
        face = positive ? 2 : 3;
        uv = vec2(dir.x, positive ? dir.z : -dir.z) / absDir.y;
    } else {
        bool positive = dir.z > 0;
        face = positive ? 4 : 5;
        uv = vec2(positive ? dir.x : -dir.x, -dir.y) / absDir.z;
    }
    
    uv = uv * 0.5 + 0.5; // Convert to [0,1] range
    ivec2 size = imageSize(probeImageMaps).xy;
    ivec2 coord = ivec2(uv * vec2(size));
        
    return imageLoad(probeImageMaps, ivec3(coord, index * 6 + face));
}

void writeCubeArray(vec3 dir, int index, vec4 color) {
    vec3 absDir = abs(dir);
    float maxComp = max(absDir.x, max(absDir.y, absDir.z));
    
    int face;
    vec2 uv;
    
    if(maxComp == absDir.x) {
        bool positive = dir.x > 0;
        face = positive ? 0 : 1;
        uv = vec2(positive ? -dir.z : dir.z, -dir.y) / absDir.x;
    } else if(maxComp == absDir.y) {
        bool positive = dir.y > 0;
        face = positive ? 2 : 3;
        uv = vec2(dir.x, positive ? dir.z : -dir.z) / absDir.y;
    } else {
        bool positive = dir.z > 0;
        face = positive ? 4 : 5;
        uv = vec2(positive ? dir.x : -dir.x, -dir.y) / absDir.z;
    }
    
    uv = uv * 0.5 + 0.5; // Convert to [0,1] range
    ivec2 size = imageSize(probeImageMaps).xy;
    ivec2 coord = ivec2(uv * vec2(size));
    
    imageStore(probeImageMaps, ivec3(coord, index * 6 + face), color);
}


bool TriIntersectBoolVersion(vec3 origin, vec3 direction, float rayMin, float rayMax, vec3 v0, vec3 v1, vec3 v2) {

	vec3 a = v0 - v1;
	vec3 b = v2 - v0;
	vec3 p = v0 - origin;
	vec3 n = cross(b, a);
	float r = dot(direction, n);

    //ignore back face
	if (r > 0)
	    return false;

	// some other early out
	if (abs(r) < 0.00001)
		return false; // you removed this on the ragdoll renderer, maybe it introduces artefacts?

	vec3 q = cross( p, direction );
	r = 1.0 / r;
	float u = dot( q, b )*r;
	float v = dot( q, a )*r;
	float t = dot( n, p )*r;

	if( u<0.0 || v<0.0 || (u+v)>1.0 )
		t = -1.0;

	if (t > rayMin && t < rayMax) {
		return true;
	}
	return false;
}

float TriIntersect(vec3 origin, vec3 direction, float rayMin, float rayMax, vec3 v0, vec3 v1, vec3 v2) {
    vec3 a = v0 - v1;
    vec3 b = v2 - v0;
    vec3 p = v0 - origin;
    vec3 n = cross(b, a);
    float r = dot(direction, n);

    // Ignore back faces
    if (r > 0.0)
        return -1.0;

    // Check if ray is parallel to the triangle
    if (abs(r) < 1e-6)
        return -1.0;

    vec3 q = cross(p, direction);
    r = 1.0 / r;
    float u = dot(q, b) * r;
    float v = dot(q, a) * r;
    float t = dot(n, p) * r;

    // Check if intersection is within the triangle
    if (u < 0.0 || v < 0.0 || (u + v) > 1.0)
        t = -1.0;

    // Check if t is within the valid range
    if (t > rayMin && t < rayMax)
        return t;

    return -1.0;
}

float DistanceSquared( vec3 A, vec3 B ) {
    vec3 C = A - B;
    return dot( C, C );
}



bool PointInOrOn( vec3 P1, vec3 P2, vec3 A, vec3 B )
{
    vec3 CP1 = cross(B - A, P1 - A);
    vec3 CP2 = cross(B - A, P2 - A);
    return dot( CP1, CP2 ) >= 0;

}

bool PointInTriangle( vec3 px, vec3 p0, vec3 p1, vec3 p2 )
{
    
    return PointInOrOn(px, p0, p1, p2) && PointInOrOn(px, p1, p2, p0) && PointInOrOn(px, p2, p0, p1);
}

vec3 IntersectPlane(vec3 rayO, vec3 rayDir, vec3 p0, vec3 p1, vec3 p2)
{
    vec3 D = rayDir;
    vec3 N = cross(p1-p0, p2-p0);
    vec3 X = rayO + D * dot(p0 - rayO, N) / dot(D, N);

    return X;
}
bool IntersectTriangle(vec3 rayO, vec3 rayDir, float rayLenght, vec3 p0, vec3 p1, vec3 p2)
{
    vec3 X = IntersectPlane(rayO, rayDir, p0, p1, p2);
    vec3 OX = X - rayO;
    //if(length(OX) > rayLenght)
        //return false;
    return PointInTriangle(X, p0, p1, p2);
}




//GLM GTX code adapated for glsl 
RayResult TriangleIntersectionTestGLM(vec3 orig, vec3 dir,vec3 v0, vec3 v1, vec3 v2) {
    RayResult rayResult;
	rayResult.hitFound = false;
        
	vec3 e1 = v1 - v0;
	vec3 e2 = v2 - v0;

	vec3 p = cross(dir, e2);
	float a = dot(e1, p);

	const float epsilon = 0.0001;
	if (a > -epsilon && a < epsilon)
		return rayResult;

	float f = 1.0f / a;
	vec3 s = orig - v0;

	rayResult.baryPosition.x = f * dot(s, p);
	if (rayResult.baryPosition.x < 0.0f || rayResult.baryPosition.x > 1.0f)
		return rayResult;

	vec3 q = cross(s, e1);
	rayResult.baryPosition.y = f * dot(dir, q);
	if (rayResult.baryPosition.y < 0.0f || (rayResult.baryPosition.x + rayResult.baryPosition.y) > 1.0f)
		return rayResult;

	rayResult.baryPosition.z = f * dot(e2, q);
    if(rayResult.baryPosition.z >= 0.0f){
        rayResult.hitFound = true;
    }

	return rayResult;
}
    
